  "builtins": {"timed": false, "attribution": "self-plus-arguments", "included_in_processes": true, "time_semantics": "ranking and UPPER BOUND on removal gain: a row's time_s includes evaluating that call's own arguments (nested builtins are subtracted, ordinary expression work is not), so removing the call recovers at most this, usually much less", "distinct": 3, "total_calls": 5,
  "items": [
    {"name": "$display", "calls": 2},
    {"name": "$time", "calls": 2},
