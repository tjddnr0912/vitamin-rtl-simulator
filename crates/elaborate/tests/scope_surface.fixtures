# The fixture modules of scope_surface.rs (HT-SURF, §5.2 Q-LEXSCOPE LS1 part 4): small crates
# parsed by `syn`, never compiled. `== CLEAN` is a whole `src` (files opened by `--- <path>`):
# a lexscope module whose surface passes I-SURF, its pins in scope_surface.tables (FIX_*).
# Every other section is CLEAN with planted hunks (`@@ <path>`, `- ` lines replaced by the
# `+ ` lines, or `+ ` lines appended when there is no `- ` line) and must fail with exactly
# the (item, position, rule) set FIX_EXPECT pins for it. NS1-NS22 are DELTA10 L1's negative
# controls ; NB1-NB8 are LS1 part 4's own (P29's doors and the stricter readings) ; NS23-NS31
# and NB9-NB13 are DELTA11 R2's (LS1 part 5: CARD, CB, MACRO-BODY, BODY-ALL, ALIAS-SELF+, and
# premise judge round 6's exact shapes). BODY-ALL pins every fn body of CLEAN, so a fixture
# that adds or edits a fn also fails BODY for that fn. NI1-NI10 are LS1 part 6's (INTERIOR: a
# type name of the crate followed through its fields to a mutable carrier). CLEAN's Elaborator
# holds a RefCell as the crate's does (lib.rs:555), so the receiver's exemption is not vacuous,
# and CLEAN's Tally / TallyInner are the clean struct INTERIOR follows and passes. NA1-NA7,
# NU1, NT1-NT9 and NS32 are LS1 part 7's (DELTA12: ADDR, UNWIND, IN-TOTAL, CARD per item). A
# path `../<f>` is a file beside the fixture crate's `src` (`../Cargo.toml`, its manifest ; a
# path dependency's files under `../../dep/`), read by IN-TOTAL's index as the real crate's
# Cargo.toml files are ; `@@ table:<NAME>` hunks edit a pinned table for one fixture (or, in
# CLEAN, for every fixture): a negative control's door, not a fixture's.
== CLEAN
--- ../Cargo.toml
[package]
name = "clean"

[dependencies]
dep = { path = "../dep" }
serde = "1"
--- ../../dep/Cargo.toml
[package]
name = "dep"
--- ../../dep/src/lib.rs
pub struct Span {
    pub lo: u32,
    pub hi: u32,
}

pub struct Ident {
    pub name: String,
    pub span: Span,
}

pub struct HierPath {
    pub segments: Vec<Ident>,
}

pub enum Expr {
    Lit(u64),
    Ref(HierPath),
}

pub struct Lvalue {
    pub path: HierPath,
    pub span: Span,
}
--- lib.rs
mod lexscope;

use dep as ast;

fn same_actual(d: &dep::Expr, a: &dep::Expr) -> bool {
    std::ptr::eq(d, a)
}

fn default_unread(ds: &[dep::Expr], a: &dep::Expr) -> bool {
    !ds.iter().any(|d| same_actual(d, a))
}

pub(crate) struct Elaborator<'s> {
    src: &'s str,
    cur_prefix: String,
    lex: lexscope::Scopes,
    shown: Option<lexscope::Shown>,
    names: Vec<String>,
    const_call_fn: std::cell::RefCell<Option<String>>,
}

impl Elaborator<'_> {
    fn error(&mut self, msg: &str) {
        self.names.push(msg.to_string());
    }

    fn flush_slot(&mut self, slot: u32) {
        self.names.truncate(slot as usize);
    }

    fn seg_label(seg: &str) -> Option<&str> {
        seg.strip_suffix(']')
    }

    fn note_key(&mut self, key: &str) {
        self.names.push(key.to_string());
    }
}

pub(crate) struct Win {
    n: u32,
}

impl Win {
    pub(crate) fn declares(&self, name: &str) -> bool {
        name.len() as u32 == self.n
    }

    pub(crate) fn get(&self) -> u32 {
        self.n
    }
}

pub(crate) fn span_holds(a: u32, b: u32) -> bool {
    a <= b
}

impl Elaborator<'_> {
    fn tidy_seg(seg: &str) -> &str {
        seg
    }

    fn lab2(seg: &str) -> Option<&str> {
        seg.strip_prefix('g')
    }

    fn get(&self, i: usize) -> Option<&String> {
        self.names.get(i)
    }

    fn drop_slot(&mut self, slot: u32) {
        self.names.truncate(slot as usize);
    }

    fn keep_slot(&mut self, slot: u32) {
        self.names.truncate(slot as usize);
    }

    fn note_paren(&mut self, k: &str) {
        self.names.push(k.to_string());
    }

    fn flag_slot(&mut self, slot: u32) {
        self.names.truncate(slot as usize);
    }
}

pub(crate) trait Note {
    fn note(&self, s: &str) -> bool;
}

impl Note for Win {
    fn note(&self, s: &str) -> bool {
        s.len() as u32 == self.n
    }
}

pub(crate) trait StrExt {
    fn dotted(&self) -> bool;
}

impl StrExt for str {
    fn dotted(&self) -> bool {
        self.contains('.')
    }
}

pub(crate) fn name_len<S: AsRef<str>>(s: S) -> usize {
    s.as_ref().len()
}

pub(crate) fn wlen<S>(s: S) -> usize
where
    S: Into<String>,
{
    s.into().len()
}

pub(crate) fn shown(x: impl std::fmt::Display) -> usize {
    x.to_string().len()
}

pub(crate) fn byte_len(b: &[u8]) -> usize {
    b.len()
}

pub(crate) fn span_len(a: u32) -> u32 {
    a
}

pub(crate) fn t_string_ref(s: &String) -> usize {
    s.len()
}

pub(crate) fn t_cow(s: std::borrow::Cow<'_, str>) -> usize {
    s.len()
}

pub(crate) fn t_box(s: Box<str>) -> usize {
    s.len()
}

pub(crate) fn t_strs(s: &[&str]) -> usize {
    s.len()
}

pub(crate) fn t_strings(s: Vec<String>) -> usize {
    s.len()
}

pub(crate) fn t_opt(s: Option<String>) -> usize {
    s.map_or(0, |x| x.len())
}

pub(crate) fn t_impl_asref(s: impl AsRef<str>) -> usize {
    s.as_ref().len()
}

pub(crate) fn t_impl_into(s: impl Into<String>) -> usize {
    s.into().len()
}

pub(crate) mod util {
    pub(crate) fn tidy(s: &str) -> bool {
        s.is_empty()
    }

    pub(crate) fn hold(s: &str) -> bool {
        s.is_empty()
    }

    pub(crate) trait Saved {
        fn mk(n: u32) -> u32;
    }
}

pub(crate) mod inner {
    pub(crate) fn probe(n: u32) -> bool {
        n == 0
    }
}
--- lexscope/mod.rs
//! a clean lexscope surface
mod inner;

pub(crate) use inner::ScopeRef;

pub(crate) struct Scopes {
    parked: Vec<ast::Lvalue>,
    cur: String,
    marks: Vec<String>,
}

pub(crate) struct Shown(String);

pub(crate) struct ShownCtx {
    frames: Vec<String>,
}

pub(crate) struct Saved {
    text: String,
}

pub(crate) struct ScopeKeyed<V> {
    map: std::collections::BTreeMap<String, V>,
}

pub(crate) enum Mark {
    Inst,
    Gen,
}

pub(crate) trait Outgoing {
    type Plain;
    fn plain(self) -> Self::Plain;
}

impl Outgoing for Shown {
    type Plain = String;
    fn plain(self) -> String {
        self.0
    }
}

impl Outgoing for ShownCtx {
    type Plain = Vec<diag::Frame>;
    fn plain(self) -> Vec<diag::Frame> {
        Vec::new()
    }
}

impl Clone for Shown {
    fn clone(&self) -> Self {
        Shown(self.0.clone())
    }
}

impl Default for Saved {
    fn default() -> Self {
        Saved { text: String::new() }
    }
}

impl std::fmt::Debug for Shown {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str("Shown(..)")
    }
}

macro_rules! zn {
    ($t:ty) => {};
}

zn!(Shown);

pub(crate) fn scope_out<T: Outgoing>(x: T) -> T::Plain {
    x.plain()
}

struct Tally {
    seen: Vec<String>,
    inner: TallyInner,
}

struct TallyInner(std::collections::BTreeMap<String, u32>);

pub(crate) fn tally_is_empty(t: &Tally) -> bool {
    t.seen.is_empty() && t.inner.0.is_empty()
}

pub(crate) fn shown_from_spelling(s: String) -> Shown {
    Shown(s)
}

fn wrap_shown(s: String) -> Shown {
    Shown(s)
}

fn reach_out(name: &str, w: &crate::Win) -> bool {
    use crate::util;
    use crate::util::hold;
    use crate::Elaborator as El;
    use crate::Note;
    let g = span_holds;
    let class = name_len(name)
        + wlen(name)
        + shown(name)
        + byte_len(name.as_bytes())
        + t_string_ref(&name.to_string())
        + t_cow(name.into())
        + t_box(name.into())
        + t_strs(&[name])
        + t_strings(vec![name.to_string()])
        + t_opt(Some(name.to_string()))
        + t_impl_asref(name)
        + t_impl_into(name);
    util::tidy(name)
        && crate::util::Saved::mk(1) == 1
        && Note::note(w, name)
        && <crate::Win as crate::Note>::note(w, name)
        && hold(name)
        && El::seg_label(name).is_some()
        && matches!(crate::Elaborator::lab2(name), Some(s) if !s.is_empty())
        && vec![span_len(1); 2].len() == 2
        && name.dotted()
        && g(1, 2)
        && class > 0
}

impl Scopes {
    pub(crate) fn is_top(&self) -> bool {
        self.cur.is_empty()
    }

    fn enter(&mut self, seg: &str) -> Saved {
        let text = std::mem::replace(&mut self.cur, seg.to_string());
        Saved { text }
    }

    fn restore(&mut self, s: Saved) {
        self.cur = s.text;
    }

    pub(crate) fn park(&mut self, lhs: ast::Lvalue) {
        self.parked.push(lhs);
    }

    pub(crate) fn is_under(&self, segs: &[dep::Ident]) -> bool {
        segs.is_empty() && self.cur.is_empty()
    }
}

impl<V> ScopeKeyed<V> {
    pub(crate) fn entry_under_cur(&mut self, lex: &Scopes, name: &str) -> &mut V
    where
        V: Default,
    {
        self.map.entry(format!("{}.{name}", lex.cur)).or_default()
    }

    pub(crate) fn drain_keys_shown(&mut self) -> Vec<Shown> {
        std::mem::take(&mut self.map).into_keys().map(Shown).collect()
    }
}

impl crate::Elaborator<'_> {
    pub(crate) fn with_scope<R>(&mut self, seg: &str, f: impl FnOnce(&mut Self) -> R) -> R {
        let saved = self.lex.enter(seg);
        let r = f(self);
        self.lex.restore(saved);
        r
    }

    pub(crate) fn disp_here(&self) -> Shown {
        wrap_shown(self.disp_here_text())
    }

    fn disp_here_text(&self) -> String {
        self.lex.cur.clone()
    }

    pub(crate) fn cur_shown_all(&self, out: &mut Vec<Shown>) {
        out.push(self.disp_here());
    }

    pub(crate) fn names_are_empty(&self) -> bool {
        self.names.is_empty()
    }

    pub(crate) fn key_under(&self, n: &str) -> String {
        format!("{}.{n}", self.lex.cur)
    }

    pub(crate) fn scope_hold(&mut self) -> Saved {
        self.lex.enter("")
    }

    pub(crate) fn scope_carry(&self) -> ScopeRef {
        inner::carry(&self.lex)
    }

    pub(crate) fn mark_is(&self, m: Mark) -> bool {
        matches!(m, Mark::Inst) && self.lex.marks.is_empty()
    }

    fn outward(&mut self) -> bool {
        self.flush_slot(0);
        self.error("internal");
        let lab = Self::seg_label("g[0]").is_some();
        self.note_key("k");
        let w = crate::Win { n: 0 };
        lab && w.declares("x") && span_holds(1, 2) && self.names.get(0).is_some()
    }

    fn outward2(&mut self, name: &str) -> usize {
        <Self>::drop_slot(self, 0);
        <crate::Elaborator<'_>>::keep_slot(self, 1);
        (Self::note_paren)(self, name);
        let _ = (*self).get(0);
        let t: Vec<&str> = Some(name).map(Self::tidy_seg).into_iter().collect();
        let w = crate::Win { n: 0 };
        [0u32].iter().for_each(|s| self.flag_slot(*s));
        t.len() + [name].iter().filter(|s| w.declares(s)).count()
    }
}
--- lexscope/inner.rs
pub(crate) struct ScopeRef {
    id: u32,
}

pub(super) fn carry(lex: &super::Scopes) -> ScopeRef {
    ScopeRef {
        id: lex.marks.len() as u32,
    }
}

fn hold(n: u32) -> bool {
    n == 0
}

fn reach() -> bool {
    use crate::inner;
    inner::probe(1) && hold(0)
}
