type
== SURF_LEAVE
# LEAVE: text out, counted, each with its closing unit (DELTA10 L1: L0 BOUNDARY, L1-L5) — empty
# until the module exists ; a row matching no failing position fails STALE
id	item	position	type	closes
== SURF_ENTER
# ENTER: text in, by role (to-scope / to-display / lookup)
item	param	role
== SURF_ENUMS
# crate-visible enums allowed (payload-free): the mark selector at LS3
name
== SURF_SHIMS
# RT-a shims (DELTA10 L2): shim, the private fn it wraps, the wrapper
shim	private	wrapper
== SURF_OUTGOING
# the boundary's impls (pinned 2 from LS2-d: Shown -> String, ShownCtx -> Vec<diag::Frame>)
type	plain
== SURF_E
# E: the Elaborator-taking fns, OUT-F / OUT-C / OUT-M by (fn, name, count), BODY (sha256 of the
# body tokens) ; FLOW (hand) in / payload / text:<sink>
item	kind	name	count	flow
